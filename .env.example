# Database (required)
DB_HOST=127.0.0.1
DB_NAME=reminder
DB_USER=reminder
DB_PASS=

# SMTP (required for email reminders)
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USER=reminder@example.com
SMTP_PASS=

# Web Push (optional; leave both values empty to disable push delivery)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Schnueddels authentication integration (required for the hosted application)
AUTH_API_URL=https://schnueddels.de/auth/api
AUTH_COOKIE_DOMAIN=.example.com
AUTH_SESSION_TIMEOUT=86400
PROJECT_KEY=reminder
PROJECT_API_SECRET=
